// Copy to App/Signing.xcconfig (gitignored) and put your Team ID here.
// Free Apple ID: the "Personal Team" ID shown in Xcode > Settings > Accounts, or in the error text of
// the first `xcodebuild -allowProvisioningUpdates` run. Paid account: developer.apple.com > Membership.
DEVELOPMENT_TEAM = ABCDE12345

